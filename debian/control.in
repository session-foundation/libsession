Source: libsession-util
Priority: optional
Maintainer: Jason Rhinelander <jason@imaginary.ca>
Build-Depends:
    debhelper-compat (= 11),
    cmake (>= 3.14),
    g++,
    pkg-config,
    liboxenc-dev (>= 1.0.7),
    liboxen-logging-dev (>= 1.2.0),
    liboxen-quic-dev (>= 1.8.0),
    nlohmann-json3-dev,
    libunbound-dev,
    nettle-dev,
    libprotobuf-dev,
    libsodium-dev,
    libsimdutf-dev (>= 7)
Standards-Version: 4.4.1
Section: libs
Homepage: https://github.com/oxen-io/libsession-util

Package: libsession-util-dev
Section: libdevel
Architecture: any
Depends: libsession-util@LIB_VERSION@ (= ${binary:Version}), ${misc:Depends},
    liboxenc-dev (>= 1.5.0),
    liboxen-logging-dev (>= 1.2.0),
    liboxen-quic-dev (>= 1.8.0),
    nlohmann-json3-dev,
    libsodium-dev
Description: Utility library for the Session messenger (headers)
 This C++17 library contains various utility functions used by different
 front-end versions of the Session messenger.
 .
 This package contains the library headers and other development files needed
 to build software using libsession-util.

Package: libsession-util@LIB_VERSION@
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: Utility library for the Session messenger (headers)
 This C++17 library contains various utility functions used by different
 front-end versions of the Session messenger.
 .
 This package contains the library file needed by software built using
 libsession-util.
