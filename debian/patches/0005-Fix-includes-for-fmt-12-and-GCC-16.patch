 include/session/parse_error.hpp                   | 2 +-
 src/json_parser.hpp                               | 2 +-
 src/pro_backend.cpp                               | 2 +-
 src/session_protocol.cpp                          | 2 +-
 src/types.cpp                                     | 5 ++++-
 6 files changed, 10 insertions(+), 5 deletions(-)

